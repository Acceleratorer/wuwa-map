{
  "name": "wayfinder-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node --env-file-if-exists=.env server/index.mjs",
    "invite": "node --env-file-if-exists=.env server/create-invite.mjs",
    "backup": "node --env-file-if-exists=.env server/backup-database.mjs",
    "devices": "node --env-file-if-exists=.env server/manage-devices.mjs",
    "convert:9268": "node tools/convert-9268-map.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "test": "pnpm test:server && pnpm test:tools && pnpm build"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
