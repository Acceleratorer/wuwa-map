    {
      "id": "kuro:1451222078694043648",
      "categoryId": "IconMap_WYQ",
      "title": "vùng im lặng",
      "x": 5939.983,
      "y": 6400.792,
      "description": "Vùng im lặng sâu ở bụng của Cryptobeak\nSát thương nhiễu xạ của nhân vật được tăng lên và sát thương dẫn điện của kẻ địch giảm đi.\nVùng nguy hiểm này ra đời cùng với hiện tượng nước biển xâm thực. Các dây âm thanh màu trắng và các vết âm thanh khổng lồ ở trung tâm khu vực là đặc điểm nổi bật nhất của nó. Ngoài những dư ảnh nguy hiểm, còn ẩn chứa những vật chất quý giá bên trong chúng.",
      "levelId": "0"
    },
